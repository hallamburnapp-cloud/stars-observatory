    given-names: Hallam
    affiliation: "University of Aberdeen"
    orcid: "https://orcid.org/ORCID-TO-BE-SUPPLIED"
repository-code: "https://github.com/hallamburnapp-cloud/stars-observatory"
url: "https://starsobservatory.org/"
license: MIT
keywords:
  - space law
  - Outer Space Treaty
  - Article VI
  - Article IX
  - Registration Convention
  - satellite catalogue
  - registration lag
  - demonstrative evidence
  - space governance
doi: 10.5281/zenodo.22662848
