    given-names: Hallam
    affiliation: "University of Aberdeen"
repository-code: "https://github.com/hallamburnapp-cloud/stars-observatory"
url: "https://starsobservatory.org/"
license: MIT
keywords:
  - space law
  - Outer Space Treaty
  - Article VI
  - Article IX
  - registration convention
  - space situational awareness
  - space debris
  - SGP4
  - space governance
